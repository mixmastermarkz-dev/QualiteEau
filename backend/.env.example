# ============================================================
# Copier ce fichier en .env et remplir toutes les valeurs.
# Une variable manquante = l'application refuse de démarrer.
# NE JAMAIS commiter .env dans git.
# ============================================================

# PostgreSQL (doit correspondre à docker-compose.yml)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# URL complète construite automatiquement par docker-compose
# (ne pas remplir ici si tu utilises docker-compose)
DATABASE_URL=

# Sécurité — générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
MAGIC_LINK_SECRET=

# Environnement : development | staging | production
ENVIRONMENT=development

# CORS — origine autorisée pour le frontend
FRONTEND_ORIGIN=http://localhost:3000

# Email transactionnel (Brevo ou autre)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Stripe (mode test uniquement en dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_A=
STRIPE_PRICE_B=
STRIPE_PRICE_C=
